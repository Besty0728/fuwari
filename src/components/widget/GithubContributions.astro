---
import type { ContributionData } from "@utils/github-contributions";
// GitHub 贡献热力图组件：纯展示，数据由调用方（Footer）通过 props 传入。
import { Icon } from "astro-icon/components";

interface Props {
	data: ContributionData;
	class?: string;
}

const { data } = Astro.props;
const className = Astro.props.class;

const CELL_SIZE = 10;
const CELL_GAP = 3;
const CELL_STEP = CELL_SIZE + CELL_GAP;
const WEEK_DAYS = 7;
// 只在周一/周三/周五显示星期标签，与 GitHub 一致
const WEEKDAY_LABELS = ["", "Mon", "", "Wed", "", "Fri", ""];
const MONTH_NAMES = [
	"Jan",
	"Feb",
	"Mar",
	"Apr",
	"May",
	"Jun",
	"Jul",
	"Aug",
	"Sep",
	"Oct",
	"Nov",
	"Dec",
];

// days[0] 未必是周日，网格开头需要补 leadingBlanks 个空占位格才能按周对齐。
// 日期一律按 UTC 解析，避免跨时区导致整体偏移一天。
const firstDay = data.days[0];
const leadingBlanks = firstDay
	? new Date(`${firstDay.date}T00:00:00Z`).getUTCDay()
	: 0;
const totalColumns = Math.ceil((leadingBlanks + data.days.length) / WEEK_DAYS);

// 遍历 days，找出每个月份第一次出现所在的列索引，用于渲染月份标签。
// 相邻月份标签间隔太近（同列或相邻列）时跳过，避免重叠。
interface MonthLabel {
	label: string;
	column: number;
}
const monthLabels: MonthLabel[] = [];
let lastMonth = -1;
let lastLabelColumn = Number.NEGATIVE_INFINITY;
// 数据起始日通常落在某月中旬（如 7/27），这个残缺首月只占一两列。
// 若为它标注月份，紧随其后的完整月份会因间距不足被跳过（Aug 丢失），与 GitHub 的显示不符。
const startsMidMonth = firstDay
	? new Date(`${firstDay.date}T00:00:00Z`).getUTCDate() !== 1
	: false;
data.days.forEach((day, index) => {
	const month = new Date(`${day.date}T00:00:00Z`).getUTCMonth();
	if (month === lastMonth) return;
	lastMonth = month;
	if (index === 0 && startsMidMonth) return;
	const column = Math.floor((leadingBlanks + index) / WEEK_DAYS);
	if (column - lastLabelColumn < 2) return;
	lastLabelColumn = column;
	monthLabels.push({ label: MONTH_NAMES[month] ?? "", column });
});

function tooltipOf(date: string, count: number): string {
	return `${date}：${count > 0 ? `${count} 次贡献` : "无贡献"}`;
}
---
<div class:list={["gh-contrib card-base p-4 sm:p-5", className]} data-palette="theme">
    <div class="flex items-center justify-between mb-4">
        <div class="text-sm font-bold text-75">
            过去一年共 <span class="text-[var(--primary)]">{data.total.toLocaleString()}</span> 次贡献
        </div>
        <button
            type="button"
            class="gh-contrib-palette-btn btn-plain scale-animation rounded-lg h-8 w-8 shrink-0"
            aria-label="切换到 GitHub 配色"
            title="切换到 GitHub 配色"
        >
            <Icon name="material-symbols:palette-outline" class="text-[1.1rem]" />
        </button>
    </div>

    <div class="flex items-start">
        <!-- 星期标签列：不参与横向滚动，与网格用 flex 并排 -->
        <div class="grid grid-rows-[repeat(7,10px)] gap-[3px] shrink-0 pr-2 mt-[17px] text-[10px] leading-[10px] text-30">
            {WEEKDAY_LABELS.map((label) => <div class="h-[10px]">{label}</div>)}
        </div>

        <div class="gh-contrib-scroll min-w-0 flex-1 overflow-x-auto hide-scrollbar">
            <div>
                <!-- 月份标签行：绝对定位到对应列的起始像素，随下方网格一起横向滚动 -->
                <div class="relative h-[14px] mb-[3px] text-[10px] text-30" style={`width:${totalColumns * CELL_STEP}px`}>
                    {monthLabels.map((m) => (
                        <span class="absolute top-0 whitespace-nowrap" style={`left:${m.column * CELL_STEP}px`}>{m.label}</span>
                    ))}
                </div>

                <div class="grid grid-flow-col grid-rows-[repeat(7,10px)] gap-[3px]">
                    {Array.from({ length: leadingBlanks }).map(() => <div class="w-[10px] h-[10px]"></div>)}
                    {data.days.map((day) => (
                        <div
                            class="gh-contrib-cell w-[10px] h-[10px] rounded-[2px]"
                            data-level={day.level}
                            title={tooltipOf(day.date, day.count)}
                        ></div>
                    ))}
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-1 mt-3 text-[10px] text-30">
        <span>Less</span>
        {[0, 1, 2, 3, 4].map((level) => (
            <span class="gh-contrib-legend inline-block w-[10px] h-[10px] rounded-[2px]" data-level={level}></span>
        ))}
        <span>More</span>
    </div>
</div>

<style>
    /* 站点始终使用暗色，这里只维护暗色一套取值，不做明暗分支 */

    /* 主题跟随色：跟随站点主色相（--hue） */
    .gh-contrib {
        --ghc-l0: oklch(0.28 0.015 var(--hue));
        --ghc-l1: oklch(0.36 0.05 var(--hue));
        --ghc-l2: oklch(0.46 0.09 var(--hue));
        --ghc-l3: oklch(0.58 0.13 var(--hue));
        --ghc-l4: oklch(0.70 0.17 var(--hue));
    }

    /* GitHub 原版配色（暗色版） */
    .gh-contrib[data-palette="github"] {
        --ghc-l0: #161b22;
        --ghc-l1: #0e4429;
        --ghc-l2: #006d32;
        --ghc-l3: #26a641;
        --ghc-l4: #39d353;
    }

    .gh-contrib-cell,
    .gh-contrib-legend {
        background-color: var(--ghc-l0);
    }
    .gh-contrib-cell[data-level="1"],
    .gh-contrib-legend[data-level="1"] {
        background-color: var(--ghc-l1);
    }
    .gh-contrib-cell[data-level="2"],
    .gh-contrib-legend[data-level="2"] {
        background-color: var(--ghc-l2);
    }
    .gh-contrib-cell[data-level="3"],
    .gh-contrib-legend[data-level="3"] {
        background-color: var(--ghc-l3);
    }
    .gh-contrib-cell[data-level="4"],
    .gh-contrib-legend[data-level="4"] {
        background-color: var(--ghc-l4);
    }
</style>

<script is:inline>
(function () {
    var PALETTE_KEY = "gh-contrib-palette";

    function updateButtonLabels(palette) {
        var label = palette === "github" ? "切换到主题配色" : "切换到 GitHub 配色";
        document.querySelectorAll(".gh-contrib-palette-btn").forEach(function (btn) {
            btn.setAttribute("aria-label", label);
            btn.setAttribute("title", label);
        });
    }

    // Footer 在 DOM 里同时存在两份（lg+ 一份、<lg 一份，靠 CSS 控制可见性），
    // 必须遍历所有 .gh-contrib 实例逐个处理，不能用 getElementById 只处理第一份。
    function initGhContrib() {
        var palette = localStorage.getItem(PALETTE_KEY) === "github" ? "github" : "theme";
        document.querySelectorAll(".gh-contrib").forEach(function (el) {
            el.dataset.palette = palette;

            // Swup 每次导航后都要重新把滚动条定位到最新日期（最右侧）
            var scroller = el.querySelector(".gh-contrib-scroll");
            if (scroller) scroller.scrollLeft = scroller.scrollWidth;

            var btn = el.querySelector(".gh-contrib-palette-btn");
            if (!btn || btn.dataset.bound) return;
            btn.dataset.bound = "true";
            btn.addEventListener("click", function () {
                var next = el.dataset.palette === "github" ? "theme" : "github";
                localStorage.setItem(PALETTE_KEY, next);
                document.querySelectorAll(".gh-contrib").forEach(function (instance) {
                    instance.dataset.palette = next;
                });
                updateButtonLabels(next);
            });
        });
        updateButtonLabels(palette);
    }

    initGhContrib();

    // 本组件会随 Footer 渲染两份，脚本可能执行多次；用全局标记防止重复注册监听器。
    // Swup 只替换 <main>，<lg 那份 Footer 在 main 外不会被替换，其脚本不会重跑，
    // 所以要靠 swup:contentReplaced 事件 + initGhContrib() 重新处理新插入的实例。
    if (!window.__ghContribListenerBound) {
        window.__ghContribListenerBound = true;
        document.addEventListener("swup:contentReplaced", initGhContrib);
    }
})();
</script>
